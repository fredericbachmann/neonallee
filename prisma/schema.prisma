// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-musl-openssl-3.0.x", "native"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum Role {
  USER
  ADMIN
}

enum Permission {
  READ
  WRITE
  OWNER
}

// ------------------------- Pads and related Stuff ----------------------------

model Pad {
  id          String          @id @default(cuid())
  name        String
  members     AuthorsOnPads[]
  published   Boolean         @default(false)
  comments    Comment[]
  description String          @default("")
  series      PadsOnSeries?
  tags        Tag[]
}

model Tag {
  id   String @id @default(cuid())
  name String
  pads Pad[]
}

model PadsOnSeries {
  pad           Pad    @relation(fields: [padId], references: [id], onDelete: Cascade)
  padId         String @unique
  series        Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId      String
  indexInSeries Int

  @@id([seriesId, indexInSeries])
}

model Series {
  id      String         @id @default(cuid())
  name    String
  pads    PadsOnSeries[]
  owner   Author         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
}

model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  pad       Pad      @relation(fields: [padId], references: [id], onDelete: Cascade)
  padId     String
}

// ----------------------------------------------------------------------

model AuthorsOnPads {
  author     Author     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  pad        Pad        @relation(fields: [padId], references: [id], onDelete: Cascade)
  padId      String
  permission Permission @default(READ)

  @@id([authorId, padId])
}

model Author {
  user        User            @relation(fields: [id], references: [id], name: "user", onDelete: Cascade)
  id          String          @id
  username    String          @unique
  artistname  String
  pads        AuthorsOnPads[]
  followers   User[]          @relation(name: "follow")
  about       String          @default("")
  ownedSeries Series[]
}

// Next-auth:

model User {
  id            String    @id @default(cuid())
  name          String?
  city          String    @default("Heidelberg")
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          Role      @default(USER)
  following     Author[]  @relation(name: "follow")
  author        Author?   @relation(name: "user")
  comments      Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
