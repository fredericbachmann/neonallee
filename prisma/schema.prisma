// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int           @id @default(autoincrement())
  email String        @unique
  role  Role          @default(USER)
  pads  UsersOnPads[]
}

model Pad {
  id           Int           @id @default(autoincrement())
  etherPadID   String
  etherGroupID String        @unique
  readOnlyID   String        @unique
  members      UsersOnPads[]
}

model UsersOnPads {
  user       User       @relation(fields: [userId], references: [id])
  userId     Int
  pad        Pad        @relation(fields: [padId], references: [id])
  padId      Int
  permission Permission @default(READ)

  @@id([userId, padId])
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

enum Permission {
  READ
  WRITE
  OWNER
}
